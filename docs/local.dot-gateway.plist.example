<?xml version="1.0" encoding="UTF-8"?>
<!-- Example LaunchAgent for dot-gateway (label: local.dot-gateway). Copy to
     ~/Library/LaunchAgents/local.dot-gateway.plist, replace /path/to/dot-gateway and
     /path/to/home with absolute paths (launchd does not expand ~ or $HOME), then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.dot-gateway.plist
     Contains no secrets: the gateway needs none. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.dot-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/path/to/dot-gateway/scripts/start.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/path/to/home/Library/Logs/dot-gateway.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/home/Library/Logs/dot-gateway.log</string>
</dict>
</plist>
